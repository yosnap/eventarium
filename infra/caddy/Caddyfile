# Caddy de producción: proxy interno del stack, detrás del proxy del orquestador.
#
# El orquestador (Traefik en Dokploy/EasyPanel) termina TLS en el dominio y reenvía
# TODO el tráfico a este Caddy por HTTP plano. Este Caddy es el único que reparte por
# ruta hacia `web`, `api` y `seaweedfs`: así el enrutado vive en el repo, no en tres
# reglas sueltas del panel, y puede aplicar reglas que el panel no sabe expresar (la de
# `@justificantes` de abajo).
#
# Web y API comparten host: la cookie de sesión es first-party sin configurar nada,
# no hace falta CORS y solo hay una cabecera de host que revisar.
#
# X-Forwarded-Host / X-Forwarded-Proto: NO se sobrescriben aquí. Las pone el proxy del
# orquestador con el host y el esquema reales (https) y Caddy las conserva porque ese
# proxy llega desde una red privada (`trusted_proxies`). Si Caddy las fijara con
# `{scheme}`, el esquema sería «http» (el tramo Traefik→Caddy va sin TLS) y la API
# y el SSR construirían URLs y cookies como si el sitio no fuera seguro.

{
	admin off
	# TLS lo termina el proxy del orquestador; este Caddy no debe pedir certificados.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Justificantes de gasto: NUNCA se sirven por esta ruta pública. Son facturas y
	# tickets con datos fiscales y personales, y el único camino a ellos es
	# `GET /api/v1/accounting/receipts/{clave}`, que exige sesión con
	# `accounting:read`, comprueba que la organización de la clave es la de la sesión y
	# responde con `Content-Disposition: attachment`.
	#
	# La identidad anónima de SeaweedFS concede `Read` sobre todo el bucket y su
	# formato de permisos solo admite prefijos literales, así que no puede excluir
	# `orgs/{uuid}/accounting-receipts/` (el UUID varía por organización). Esta regla
	# es la que cierra el hueco: el puerto S3 no se publica en producción, así que
	# esta es la única entrada anónima al bucket. Va ANTES del `handle /media/*`:
	# Caddy evalúa los `handle` en orden y el primero que coincide gana.
	@justificantes path_regexp ^/media/orgs/[^/]+/accounting-receipts/
	handle @justificantes {
		respond "Forbidden" 403
	}

	# El bucket se llama «media», así que la ruta coincide con la clave path-style del
	# objeto en S3. Los objetos son inmutables (la clave lleva un UUID), de ahí la caché
	# larga.
	handle /media/* {
		reverse_proxy seaweedfs:8333 {
			header_up Host {upstream_hostport}
		}
		header Cache-Control "public, max-age=86400, immutable"
	}

	handle {
		reverse_proxy web:4000
	}
}
